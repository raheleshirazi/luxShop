/* ============================================================
   LOOXSHOP — ADMIN PANEL STYLES
   Description: استایل‌های اختصاصی پنل مدیریت و صفحه ورود ادمین
   ============================================================ */

/* ============================================================
   1. ADMIN LOGIN PAGE
============================================================ */
.admin-login-body {
    background:
        radial-gradient(circle at 20% 30%, rgba(212, 80, 96, .25), transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(128, 0, 32, .3), transparent 50%),
        linear-gradient(135deg, #5e0018 0%, #800020 50%, #47000f 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    margin: 0;
    position: relative;
    overflow-x: hidden;
}

.admin-login-body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
        radial-gradient(circle at 1px 1px, rgba(255, 249, 242, .08) 1px, transparent 0);
    background-size: 32px 32px;
    pointer-events: none;
    z-index: 0;
}

.admin-login-wrap {
    width: 100%;
    max-width: 460px;
    position: relative;
    z-index: 1;
}

.admin-login-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 249, 242, .85);
    font-size: 13.5px;
    font-weight: 700;
    margin-bottom: 20px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 249, 242, .1);
    border: 1px solid rgba(255, 249, 242, .15);
    backdrop-filter: blur(10px);
    transition: all .3s ease;
    text-decoration: none;
}

.admin-login-back:hover {
    background: rgba(255, 249, 242, .2);
    color: #fff;
    transform: translateX(-4px);
}

.admin-login-card {
    background: #FFF9F2;
    border-radius: 28px;
    padding: 44px 36px 34px;
    box-shadow:
        0 30px 80px rgba(0, 0, 0, .4),
        0 0 0 1px rgba(255, 249, 242, .06) inset;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.admin-login-card::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(212, 80, 96, .18), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
}

.admin-login-card::after {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -80px;
    width: 240px;
    height: 240px;
    background: radial-gradient(circle, rgba(128, 0, 32, .1), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
}

.admin-login-card>* {
    position: relative;
    z-index: 1;
}

.admin-login-card__icon {
    width: 84px;
    height: 84px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #800020, #D45060);
    color: #FFF9F2;
    border-radius: 50%;
    box-shadow:
        0 12px 30px rgba(128, 0, 32, .35),
        0 0 0 6px rgba(212, 80, 96, .12);
    animation: adminIconPulse 3s ease-in-out infinite;
}

@keyframes adminIconPulse {

    0%,
    100% {
        box-shadow: 0 12px 30px rgba(128, 0, 32, .35), 0 0 0 6px rgba(212, 80, 96, .12);
    }

    50% {
        box-shadow: 0 12px 30px rgba(128, 0, 32, .45), 0 0 0 14px rgba(212, 80, 96, .06);
    }
}

.admin-login-card__title {
    font-size: 24px;
    font-weight: 900;
    color: #800020;
    margin-bottom: 8px;
    line-height: 1.4;
}

.admin-login-card__subtitle {
    font-size: 13.5px;
    color: #6b5a5a;
    line-height: 1.9;
    margin-bottom: 26px;
    max-width: 340px;
    margin-inline: auto;
}

.admin-login-card .auth-form {
    text-align: start;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.admin-login-card__hint {
    margin-top: 24px;
    padding: 16px 20px;
    background: linear-gradient(135deg, #F3E6D5 0%, #f9efe2 100%);
    border-radius: 16px;
    font-size: 12.5px;
    color: #6b5a5a;
    line-height: 2;
    border-inline-start: 4px solid #D45060;
    text-align: start;
}

.admin-login-card__hint strong {
    color: #800020;
    font-weight: 800;
    display: block;
    margin-bottom: 4px;
}

.admin-login-card__hint code {
    background: #800020;
    color: #FFF9F2;
    padding: 3px 10px;
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    direction: ltr;
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .5px;
}

.admin-login-card__trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px dashed #e8d9c8;
    font-size: 12px;
    color: #6b5a5a;
    font-weight: 600;
}

.admin-login-card__trust span:nth-child(odd) {
    color: #800020;
}

.admin-login-copyright {
    text-align: center;
    margin-top: 24px;
    font-size: 12.5px;
    color: rgba(255, 249, 242, .6);
    font-weight: 500;
}

/* Auth alert (shared) */
.admin-login-card .auth-alert,
.admin-login-body .auth-alert {
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 13.5px;
    font-weight: 700;
    margin-bottom: 18px;
    border-inline-start: 4px solid transparent;
    text-align: start;
    animation: adminFadeIn .3s ease;
}

.admin-login-card .auth-alert--error,
.admin-login-body .auth-alert--error {
    background: #ffebee;
    color: #b71c1c;
    border-inline-start-color: #b71c1c;
}

.admin-login-card .auth-alert--success,
.admin-login-body .auth-alert--success {
    background: #e8f5e9;
    color: #1b5e20;
    border-inline-start-color: #2e7d32;
}

@keyframes adminFadeIn {
    from {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ============================================================
   2. ADMIN HEADER
============================================================ */
.admin-header {
    background: #fff;
    border-bottom: 1px solid #e8d9c8;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(128, 0, 32, .04);
}

.admin-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    flex-wrap: wrap;
    padding-inline: 20px;
    max-width: 100%;
}

.admin-header .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.admin-header .logo__mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #800020, #D45060);
    color: #FFF9F2;
    font-weight: 900;
    font-size: 18px;
    border-radius: 12px;
    box-shadow: 0 6px 16px rgba(128, 0, 32, .28);
}

.admin-header .logo__text {
    font-size: 19px;
    font-weight: 700;
    color: #800020;
}

.admin-header .logo__text b {
    color: #D45060;
    font-weight: 900;
}

.admin-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #800020, #5e0018);
    color: #FFF9F2;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 800;
    box-shadow: 0 4px 12px rgba(128, 0, 32, .2);
}

.admin-header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-inline-start: auto;
}

.admin-header__btn {
    padding: 9px 16px;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: all .3s ease;
}

.admin-header__logout {
    width: 42px;
    height: 42px;
    color: #D45060;
    background: #ffebee;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: none;
    cursor: pointer;
    transition: all .3s ease;
}

.admin-header__logout:hover {
    background: #D45060;
    color: #fff;
    transform: rotate(-8deg);
}

/* ============================================================
   3. ADMIN LAYOUT
============================================================ */
body.admin-page {
    background: #f7f1ea;
    margin: 0;
}

.admin-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: calc(100vh - 68px);
    align-items: start;
}

/* ============================================================
   4. ADMIN SIDEBAR
============================================================ */
.admin-sidebar {
    background: #fff;
    border-inline-end: 1px solid #e8d9c8;
    position: sticky;
    top: 68px;
    height: calc(100vh - 68px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 20px 14px 0;
}

.admin-sidebar .admin-menu {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding-bottom: 12px;
    margin-bottom: 12px;
    scrollbar-width: thin;
}

.admin-sidebar .admin-menu::-webkit-scrollbar {
    width: 6px;
}

.admin-sidebar::-webkit-scrollbar {
    width: 6px;
}


.admin-sidebar .admin-menu::-webkit-scrollbar-thumb {
    background: #e8d9c8;
    border-radius: 999px;
}

/* فوتر همیشه در پایین دیده بشه */
.admin-sidebar__footer {
    flex-shrink: 0;
    padding: 14px 6px;
    border-top: 1px solid #e8d9c8;
    margin-top: 0;
    background: #fff;
    position: relative;
    z-index: 2;
}


.admin-sidebar::-webkit-scrollbar-thumb {
    background: #e8d9c8;
    border-radius: 999px;
}

.admin-sidebar__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 10px 16px;
    border-bottom: 1px solid #e8d9c8;
    margin-bottom: 16px;
}

.admin-sidebar__head strong {
    font-size: 15px;
    font-weight: 900;
    color: #800020;
}

.admin-sidebar__close {
    display: none;
    font-size: 18px;
    color: #800020;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #F3E6D5;
    border: none;
    cursor: pointer;
}

.admin-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
}

.admin-menu__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    color: #6b5a5a;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: start;
    transition: all .3s ease;
    font-family: inherit;
    width: 100%;
}

.admin-menu__item svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
}

.admin-menu__item:hover {
    background: #F3E6D5;
    color: #800020;
}

.admin-menu__item.is-active {
    background: linear-gradient(135deg, #800020, #5e0018);
    color: #FFF9F2;
    box-shadow: 0 6px 16px rgba(128, 0, 32, .25);
}

.admin-menu__item.is-active svg {
    color: #FFF9F2;
}

.admin-menu__badge {
    margin-inline-start: auto;
    min-width: 24px;
    height: 22px;
    border-radius: 999px;
    background: #D45060;
    color: #fff;
    font-size: 11.5px;
    font-weight: 800;
    display: grid;
    place-items: center;
    padding: 0 6px;
}

.admin-menu__item.is-active .admin-menu__badge {
    background: #FFF9F2;
    color: #800020;
}

.admin-sidebar__footer {
    padding-top: 16px;
    border-top: 1px solid #e8d9c8;
    margin-top: 16px;
}

.admin-user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 8px;
    border-radius: 12px;
    background: #F3E6D5;
}

.admin-user__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #800020, #D45060);
    color: #FFF9F2;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 17px;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
}

.admin-user__info {
    min-width: 0;
}

.admin-user__info strong {
    display: block;
    font-size: 13px;
    color: #800020;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.admin-user__info small {
    font-size: 11.5px;
    color: #6b5a5a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
}

/* ============================================================
   5. ADMIN CONTENT
============================================================ */
.admin-content {
    padding: 24px 28px 40px;
    min-width: 0;
}

.admin-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}

.admin-topbar__title {
    font-size: 26px;
    font-weight: 900;
    color: #800020;
    margin: 0;
    line-height: 1.3;
}

.admin-topbar__date {
    font-size: 13px;
    color: #6b5a5a;
    background: #fff;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid #e8d9c8;
    font-weight: 600;
}

.admin-sidebar-toggle {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #e8d9c8;
    color: #800020;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

/* ============================================================
   6. ADMIN SECTIONS
============================================================ */
.admin-section {
    display: none;
}

.admin-section.is-active {
    display: block;
    animation: adminFadeIn .3s ease;
}

/* ============================================================
   7. STAT CARDS
============================================================ */
.admin-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.admin-stat-card {
    background: #fff;
    border: 1px solid #e8d9c8;
    border-radius: 20px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 2px 10px rgba(128, 0, 32, .06);
    transition: all .3s ease;
    position: relative;
    overflow: hidden;
}

.admin-stat-card::before {
    content: '';
    position: absolute;
    top: -30px;
    right: -30px;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    opacity: .06;
    pointer-events: none;
}

.admin-stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(128, 0, 32, .1);
}

.admin-stat-card__icon {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: #FFF9F2;
}

.admin-stat-card__icon svg {
    width: 24px;
    height: 24px;
}

.admin-stat-card__icon--wine {
    background: linear-gradient(135deg, #800020, #5e0018);
}

.admin-stat-card__icon--rose {
    background: linear-gradient(135deg, #D45060, #b83d4c);
}

.admin-stat-card__icon--green {
    background: linear-gradient(135deg, #2e7d32, #4caf50);
}

.admin-stat-card__icon--blue {
    background: linear-gradient(135deg, #1565c0, #42a5f5);
}

.admin-stat-card__label {
    display: block;
    font-size: 13px;
    color: #6b5a5a;
    margin-bottom: 4px;
}

.admin-stat-card strong {
    font-size: 20px;
    font-weight: 900;
    color: #800020;
}

/* ============================================================
   8. ADMIN PANEL
============================================================ */
.admin-panel {
    background: #fff;
    border: 1px solid #e8d9c8;
    border-radius: 20px;
    padding: 22px;
    margin-bottom: 22px;
    box-shadow: 0 2px 10px rgba(128, 0, 32, .06);
}

.admin-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e8d9c8;
    flex-wrap: wrap;
}

.admin-panel__head--flex {
    align-items: flex-start;
}

.admin-panel__head h2 {
    font-size: 17px;
    font-weight: 900;
    color: #800020;
    margin: 0;
}

.admin-panel__sub {
    font-size: 13px;
    color: #6b5a5a;
    margin-top: 4px;
}

/* ============================================================
   9. ADMIN FILTERS
============================================================ */
.admin-filters {
    display: flex;
    gap: 12px;
    margin-bottom: 18px;
    flex-wrap: wrap;
}

.admin-search {
    flex: 1;
    min-width: 220px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #FFF9F2;
    border: 1.5px solid #e8d9c8;
    border-radius: 999px;
    padding: 4px 16px;
    transition: all .3s ease;
}

.admin-search:focus-within {
    border-color: #800020;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(128, 0, 32, .08);
}

.admin-search svg {
    color: #6b5a5a;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
}

.admin-search:focus-within svg {
    color: #800020;
}

.admin-search input {
    flex: 1;
    padding: 10px 0;
    background: transparent;
    font-size: 14px;
    border: none;
    outline: none;
    color: inherit;
    font-family: inherit;
    min-width: 0;
}

.admin-select {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1.5px solid #e8d9c8;
    background: #FFF9F2;
    font-weight: 700;
    color: #800020;
    font-size: 13.5px;
    cursor: pointer;
    min-width: 180px;
    font-family: inherit;
    transition: all .3s ease;
}

.admin-select:focus {
    border-color: #800020;
    outline: none;
    box-shadow: 0 0 0 4px rgba(128, 0, 32, .08);
}

/* ============================================================
   10. ADMIN TABLE
============================================================ */
.admin-table-wrap {
    overflow-x: auto;
    border-radius: 16px;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
}

.admin-table thead th {
    background: #F3E6D5;
    color: #800020;
    font-size: 12.5px;
    font-weight: 800;
    padding: 12px 14px;
    text-align: start;
    white-space: nowrap;
    border-bottom: 1px solid #e8d9c8;
}

.admin-table thead th:first-child {
    border-start-start-radius: 12px;
}

.admin-table thead th:last-child {
    border-start-end-radius: 12px;
}

.admin-table tbody td {
    padding: 14px;
    font-size: 13.5px;
    color: #2b1518;
    border-bottom: 1px solid #f0e6d8;
    vertical-align: middle;
}

.admin-table tbody tr:last-child td {
    border-bottom: none;
}

.admin-table tbody tr {
    transition: background .2s ease;
}

.admin-table tbody tr:hover {
    background: #FFF9F2;
}

.admin-table__empty {
    text-align: center;
    color: #6b5a5a;
    font-size: 14px;
    padding: 40px 20px !important;
}

.admin-thumb {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: cover;
    background: #F3E6D5;
    border: 1px solid #e8d9c8;
}

/* ============================================================
   11. ADMIN BADGES
============================================================ */
.admin-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 800;
    white-space: nowrap;
}

.admin-badge--pending {
    background: #fff8e1;
    color: #b26a00;
}

.admin-badge--processing {
    background: #e3f2fd;
    color: #1565c0;
}

.admin-badge--shipped {
    background: #f3e5f5;
    color: #6a1b9a;
}

.admin-badge--delivered {
    background: #e8f5e9;
    color: #2e7d32;
}

.admin-badge--cancelled {
    background: #ffebee;
    color: #b71c1c;
}

.admin-badge--ok {
    background: #e8f5e9;
    color: #2e7d32;
}

.admin-badge--low {
    background: #fff8e1;
    color: #b26a00;
}

.admin-badge--out {
    background: #ffebee;
    color: #b71c1c;
}

/* ============================================================
   12. ADMIN ACTION BUTTONS
============================================================ */
.admin-actions {
    display: flex;
    gap: 6px;
}

.admin-action-btn {
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 700;
    background: #F3E6D5;
    color: #800020;
    border: none;
    cursor: pointer;
    transition: all .3s ease;
    white-space: nowrap;
    font-family: inherit;
}

.admin-action-btn:hover {
    background: #800020;
    color: #FFF9F2;
    transform: translateY(-1px);
}

.admin-action-btn--edit {
    color: #1565c0;
    background: #e3f2fd;
}

.admin-action-btn--edit:hover {
    background: #1565c0;
    color: #fff;
}

.admin-action-btn--delete {
    color: #b71c1c;
    background: #ffebee;
}

.admin-action-btn--delete:hover {
    background: #b71c1c;
    color: #fff;
}

.admin-status-select {
    padding: 6px 12px;
    border-radius: 8px;
    border: 1.5px solid #e8d9c8;
    background: #FFF9F2;
    font-size: 12.5px;
    font-weight: 700;
    color: #800020;
    cursor: pointer;
    font-family: inherit;
    transition: all .3s ease;
}

.admin-status-select:focus {
    border-color: #800020;
    outline: none;
}

/* ============================================================
   13. ADMIN EMPTY STATE
============================================================ */
.admin-empty {
    text-align: center;
    padding: 60px 20px;
    color: #6b5a5a;
}

.admin-empty__icon {
    font-size: 54px;
    opacity: .5;
    margin-bottom: 12px;
    line-height: 1;
}

.admin-empty p {
    font-size: 14px;
    font-weight: 600;
}

/* ============================================================
   14. ADMIN USER AVATAR (small)
============================================================ */
.admin-user-avatar-sm {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #800020, #D45060);
    color: #FFF9F2;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 15px;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    border: 2px solid #fff;
    box-shadow: 0 2px 8px rgba(128, 0, 32, .15);
}

.admin-user-avatar-lg {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: linear-gradient(135deg, #800020, #D45060);
    color: #FFF9F2;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 30px;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    border: 4px solid #fff;
    box-shadow: 0 8px 24px rgba(128, 0, 32, .22);
}

/* ============================================================
   15. ADMIN MESSAGES
============================================================ */
.admin-messages {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.admin-message {
    background: #FFF9F2;
    border: 1px solid #e8d9c8;
    border-radius: 16px;
    padding: 18px;
    transition: all .3s ease;
}

.admin-message:hover {
    border-color: #800020;
    box-shadow: 0 4px 12px rgba(128, 0, 32, .08);
}

.admin-message__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom: 1px dashed #e8d9c8;
    flex-wrap: wrap;
}

.admin-message__head strong {
    display: block;
    font-size: 14px;
    color: #800020;
    font-weight: 800;
    margin-bottom: 2px;
}

.admin-message__head small {
    font-size: 12px;
    color: #6b5a5a;
    direction: ltr;
}

.admin-message__date {
    font-size: 12px;
    color: #6b5a5a;
    white-space: nowrap;
}

.admin-message__subject {
    font-size: 13.5px;
    color: #2b1518;
    margin-bottom: 8px;
}

.admin-message__subject strong {
    color: #800020;
}

.admin-message__body {
    font-size: 13.5px;
    color: #6b5a5a;
    line-height: 1.9;
    background: #fff;
    padding: 12px 14px;
    border-radius: 10px;
    margin-bottom: 12px;
    white-space: pre-wrap;
    border: 1px solid #f0e6d8;
}

.admin-message__actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

/* ============================================================
   16. ADMIN TICKETS
============================================================ */
.admin-tickets {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.admin-ticket {
    background: #FFF9F2;
    border: 1px solid #e8d9c8;
    border-radius: 16px;
    padding: 18px;
    transition: all .3s ease;
}

.admin-ticket:hover {
    border-color: #800020;
    box-shadow: 0 4px 12px rgba(128, 0, 32, .08);
}

.admin-ticket__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px dashed #e8d9c8;
    flex-wrap: wrap;
}

.admin-ticket__head strong {
    display: block;
    font-size: 14.5px;
    color: #800020;
    font-weight: 800;
    margin-bottom: 3px;
}

.admin-ticket__head small {
    font-size: 11.5px;
    color: #6b5a5a;
}

.admin-ticket__badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.admin-ticket__body p {
    font-size: 13px;
    color: #6b5a5a;
    margin-bottom: 6px;
}

.admin-ticket__body p strong {
    color: #800020;
    font-weight: 800;
}

.admin-ticket__message {
    background: #fff;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid #f0e6d8;
    line-height: 1.9;
    margin-top: 8px !important;
    white-space: pre-wrap;
    font-size: 13.5px;
}

.admin-ticket__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    padding-top: 12px;
    margin-top: 12px;
    border-top: 1px dashed #e8d9c8;
    flex-wrap: wrap;
}

/* ============================================================
   17. ADMIN MODAL
============================================================ */
.admin-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.admin-modal.is-open {
    display: flex;
    animation: adminFadeIn .25s ease;
}

.admin-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(43, 21, 24, .55);
    backdrop-filter: blur(4px);
    cursor: pointer;
}

.admin-modal__dialog {
    position: relative;
    background: #fff;
    border-radius: 24px;
    width: 100%;
    max-width: 560px;
    max-height: 90vh;
    /* کمی کمتر برای اطمینان */
    height: auto;
    display: flex;
    flex-direction: column;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .3);
    overflow: hidden;
    animation: adminModalIn .3s cubic-bezier(.4, 0, .2, 1);
}

.admin-modal__dialog--wide {
    max-width: 760px;
}

@keyframes adminModalIn {
    from {
        opacity: 0;
        transform: scale(.95) translateY(20px);
    }

    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.admin-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-bottom: 1px solid #e8d9c8;
    background: #F3E6D5;
}

.admin-modal__head h2 {
    font-size: 17px;
    font-weight: 900;
    color: #800020;
    margin: 0;
}

.admin-modal__head .icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: #800020;
    display: grid;
    place-items: center;
    border: none;
    cursor: pointer;
    font-size: 16px;
    font-weight: 700;
    transition: all .3s ease;
}

.admin-modal__head .icon-btn:hover {
    background: #800020;
    color: #fff;
}

.admin-modal__body {
    padding: 22px 22px 32px;
    overflow-y: auto;
    overflow-x: hidden;
    flex: 1 1 auto;
    min-height: 0;
    /* ← کلید حل مشکل */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
}

.admin-modal__body::-webkit-scrollbar {
    width: 8px;
}

.admin-modal__body::-webkit-scrollbar-track {
    background: #FFF9F2;
    border-radius: 999px;
}

.admin-modal__body::-webkit-scrollbar-thumb {
    background: #e8d9c8;
    border-radius: 999px;
    border: 2px solid #FFF9F2;
}

.admin-modal__body::-webkit-scrollbar-thumb:hover {
    background: #800020;
}

.admin-modal__foot {
    padding: 16px 22px;
    border-top: 1px solid #e8d9c8;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    background: #FFF9F2;
    flex-wrap: wrap;
}

/* ============================================================
   18. FORM GRID (inside modal)
============================================================ */
.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
}

.form-field--full {
    grid-column: 1 / -1;
}

.form-field label {
    font-size: 13px;
    font-weight: 700;
    color: #800020;
}

.form-field input,
.form-field select,
.form-field textarea {
    padding: 12px 16px;
    border-radius: 12px;
    border: 1.5px solid #e8d9c8;
    background: #FFF9F2;
    font-size: 14px;
    font-family: inherit;
    transition: all .3s ease;
    resize: vertical;
    width: 100%;
    color: #2b1518;
    outline: none;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
    border-color: #800020;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(128, 0, 32, .08);
}

/* ============================================================
   19. ORDER MODAL CONTENT
============================================================ */
.admin-order-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 20px;
    padding: 16px;
    background: #FFF9F2;
    border-radius: 12px;
    border: 1px solid #f0e6d8;
}

.admin-order-meta>div {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.admin-order-meta span {
    font-size: 12px;
    color: #6b5a5a;
}

.admin-order-meta strong {
    font-size: 14px;
    color: #800020;
    font-weight: 800;
}

.admin-order-subtitle {
    font-size: 15px;
    font-weight: 800;
    color: #800020;
    margin: 20px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px dashed #e8d9c8;
}

.admin-order-items {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.admin-order-item {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 12px;
    align-items: center;
    background: #FFF9F2;
    border: 1px solid #f0e6d8;
    border-radius: 12px;
    padding: 10px;
}

.admin-order-item img {
    width: 52px;
    height: 52px;
    border-radius: 8px;
    object-fit: cover;
    background: #F3E6D5;
}

.admin-order-item strong {
    display: block;
    font-size: 13.5px;
    font-weight: 800;
    color: #800020;
}

.admin-order-item small {
    font-size: 12px;
    color: #6b5a5a;
}

.admin-order-item>span {
    font-size: 13.5px;
    font-weight: 900;
    color: #800020;
    white-space: nowrap;
}

.admin-order-summary {
    background: #F3E6D5;
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
}

.admin-order-summary>div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 13.5px;
    color: #6b5a5a;
    margin-bottom: 8px;
}

.admin-order-summary>div:last-child {
    margin-bottom: 0;
}

.admin-order-summary strong {
    color: #800020;
    font-weight: 900;
}

.admin-order-summary__total {
    padding-top: 10px;
    margin-top: 10px;
    border-top: 1px dashed #d4c3a8;
}

.admin-order-summary__total strong {
    font-size: 17px;
}

/* ============================================================
   20. USER DETAIL MODAL
============================================================ */
.admin-user-header {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid #e8d9c8;
}

.admin-user-header__info h3 {
    font-size: 18px;
    font-weight: 900;
    color: #800020;
    margin-bottom: 4px;
}

.admin-user-header__info p {
    font-size: 13.5px;
    color: #6b5a5a;
    margin-bottom: 2px;
}

.admin-user-header__info small {
    font-size: 12px;
    color: #b3a29a;
}

.admin-user-wallet {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    background: #F3E6D5;
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 22px;
}

.admin-user-wallet>div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
}

.admin-user-wallet span {
    font-size: 12px;
    color: #6b5a5a;
}

.admin-user-wallet strong {
    font-size: 15px;
    color: #800020;
    font-weight: 900;
}

.admin-user-section-title {
    font-size: 14.5px;
    font-weight: 800;
    color: #800020;
    margin: 22px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px dashed #e8d9c8;
}

.admin-user-addresses,
.admin-user-orders,
.admin-user-tickets {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.admin-user-address {
    background: #FFF9F2;
    border: 1px solid #f0e6d8;
    border-radius: 12px;
    padding: 14px 16px;
}

.admin-user-address strong {
    font-size: 13.5px;
    color: #800020;
    font-weight: 800;
    margin-inline-end: 8px;
}

.admin-address-default {
    background: #F3E6D5;
    color: #800020;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
}

.admin-user-address p {
    margin-top: 6px;
    font-size: 13px;
    color: #6b5a5a;
    line-height: 1.85;
}

.admin-user-order,
.admin-user-ticket {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #FFF9F2;
    border: 1px solid #f0e6d8;
    border-radius: 12px;
    padding: 12px 16px;
    flex-wrap: wrap;
}

.admin-user-order strong,
.admin-user-ticket strong {
    display: block;
    font-size: 13px;
    color: #800020;
    font-weight: 800;
}

.admin-user-order small,
.admin-user-ticket small {
    display: block;
    font-size: 11.5px;
    color: #6b5a5a;
}

.admin-user-order>span {
    font-size: 13px;
    font-weight: 800;
    color: #800020;
}

.admin-empty-line {
    text-align: center;
    color: #6b5a5a;
    font-size: 13px;
    padding: 14px;
    background: #FFF9F2;
    border-radius: 12px;
    margin: 0;
    border: 1px dashed #e8d9c8;
}

/* ============================================================
   21. RESPONSIVE — ADMIN
============================================================ */
@media (max-width: 1200px) {
    .admin-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 1024px) {
    .admin-layout {
        grid-template-columns: 220px 1fr;
    }

    .admin-header__btn-text {
        display: none;
    }

    .admin-header__btn {
        width: 42px;
        padding: 0;
        height: 42px;
        justify-content: center;
    }
}

@media (max-width: 900px) {
    .admin-header__inner {
        min-height: 60px;
        padding-block: 10px;
        padding-inline: 14px;
    }

    .admin-header__badge {
        display: none;
    }

    .admin-layout {
        grid-template-columns: 1fr;
    }

    .admin-sidebar {
        position: fixed;
        top: 0;
        inset-inline-start: 0;
        width: min(280px, 85vw);
        height: 100vh;
        z-index: 1100;
        transform: translateX(-100%);
        transition: transform .3s cubic-bezier(.4, 0, .2, 1);
        box-shadow: 0 20px 60px rgba(0, 0, 0, .25);
        padding-top: 22px;
    }

    [dir="rtl"] .admin-sidebar {
        transform: translateX(100%);
    }

    .admin-sidebar.is-open,
    [dir="rtl"] .admin-sidebar.is-open {
        transform: translateX(0);
    }

    .admin-sidebar__close {
        display: grid;
        place-items: center;
    }

    .admin-sidebar-toggle {
        display: inline-flex;
    }

    .admin-topbar__date {
        display: none;
    }

    .admin-content {
        padding: 18px 14px 32px;
    }

    .admin-panel {
        padding: 16px;
    }

    .admin-stat-card {
        padding: 16px;
        gap: 12px;
    }

    .admin-stat-card__icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
    }

    .admin-stat-card strong {
        font-size: 17px;
    }

    .admin-filters {
        gap: 8px;
    }

    .admin-select {
        min-width: 0;
        flex: 1;
    }

    .admin-table {
        min-width: 600px;
    }

    .admin-table thead th {
        padding: 10px;
        font-size: 12px;
    }

    .admin-table tbody td {
        padding: 12px 10px;
        font-size: 13px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .admin-user-header {
        flex-direction: column;
        text-align: center;
        gap: 12px;
    }

    .admin-user-wallet {
        grid-template-columns: 1fr;
        gap: 8px;
    }

    .admin-user-wallet>div {
        flex-direction: row;
        justify-content: space-between;
        text-align: start;
        padding: 6px 0;
        border-bottom: 1px dashed #e8d9c8;
    }

    .admin-user-wallet>div:last-child {
        border-bottom: none;
    }

    .admin-user-order,
    .admin-user-ticket {
        flex-direction: column;
        align-items: flex-start;
    }

    .admin-ticket__actions {
        flex-direction: column;
        align-items: stretch;
    }

    .admin-ticket__actions .admin-status-select,
    .admin-ticket__actions .admin-action-btn {
        width: 100%;
    }

    .admin-modal {
        padding: 10px;
    }

    .admin-modal__dialog {
        max-height: 95vh;
    }
}

@media (max-width: 480px) {
    .admin-stats {
        grid-template-columns: 1fr;
    }

    .admin-order-meta {
        grid-template-columns: 1fr;
    }

    .admin-login-card {
        padding: 32px 22px 26px;
    }

    .admin-login-card__title {
        font-size: 20px;
    }

    .admin-login-card__icon {
        width: 72px;
        height: 72px;
    }
}

/* ============================================================
   22. TOAST (if not already in style.css)
============================================================ */
.admin-page .toast,
.admin-login-body .toast {
    position: fixed;
    bottom: 28px;
    inset-inline-start: 28px;
    background: #800020;
    color: #FFF9F2;
    padding: 14px 24px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 20px 60px rgba(128, 0, 32, .3);
    z-index: 1300;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all .3s ease;
    max-width: calc(100vw - 32px);
}

.admin-page .toast.is-visible,
.admin-login-body .toast.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

@media (max-width: 768px) {

    .admin-page .toast,
    .admin-login-body .toast {
        inset-inline: 16px;
        bottom: 16px;
        text-align: center;
    }
}

/* ============================================================
   23. REDUCED MOTION
============================================================ */
@media (prefers-reduced-motion: reduce) {

    .admin-login-card__icon,
    .admin-modal__dialog {
        animation: none !important;
    }
}

/* ============================================================
   24. PRODUCT MODAL — TABS
============================================================ */
.admin-modal__dialog--xwide {
    max-width: 880px;
}

.product-tabs {
    display: flex;
    gap: 4px;
    background: #FFF9F2;
    border-bottom: 1px solid #e8d9c8;
    padding: 0 14px;
    overflow-x: auto;
    scrollbar-width: none;
}

.product-tabs::-webkit-scrollbar {
    display: none;
}

.product-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    color: #6b5a5a;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all .3s ease;
    white-space: nowrap;
    flex-shrink: 0;
}

.product-tab svg {
    flex-shrink: 0;
    opacity: .7;
}

.product-tab:hover {
    color: #800020;
}

.product-tab.is-active {
    color: #800020;
    border-bottom-color: #D45060;
}

.product-tab.is-active svg {
    opacity: 1;
}

.product-panel {
    display: none;
    flex-direction: column;
    gap: 16px;
    animation: adminFadeIn .25s ease;
}

.product-panel.is-active {
    display: flex;
}

.field-hint {
    display: block;
    font-size: 11.5px;
    color: #6b5a5a;
    margin-top: 4px;
    line-height: 1.7;
}

/* ============================================================
   25. GALLERY TOGGLE
============================================================ */
.gallery-toggle-wrap {
    background: #F3E6D5;
    border: 1px dashed #d4c3a8;
    border-radius: 14px;
    padding: 4px;
    margin-top: 4px;
}

.gallery-toggle {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    cursor: pointer;
    border-radius: 12px;
    transition: background .3s ease;
}

.gallery-toggle:hover {
    background: rgba(255, 255, 255, .5);
}

.gallery-toggle input {
    display: none;
}

.gallery-toggle__switch {
    position: relative;
    width: 46px;
    height: 26px;
    border-radius: 999px;
    background: #cfd3d6;
    flex-shrink: 0;
    transition: background .3s ease;
}

.gallery-toggle__switch::after {
    content: '';
    position: absolute;
    top: 2px;
    inset-inline-start: 2px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 4px rgba(0, 0, 0, .15);
    transition: all .3s ease;
}

.gallery-toggle input:checked+.gallery-toggle__switch {
    background: #800020;
}

.gallery-toggle input:checked+.gallery-toggle__switch::after {
    inset-inline-start: 22px;
}

.gallery-toggle__label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
}

.gallery-toggle__label strong {
    font-size: 14px;
    color: #800020;
    font-weight: 800;
}

.gallery-toggle__label small {
    font-size: 12px;
    color: #6b5a5a;
    line-height: 1.7;
}

/* ============================================================
   26. GALLERY BOX
============================================================ */
.gallery-box {
    background: #FFF9F2;
    border: 1px solid #e8d9c8;
    border-radius: 14px;
    padding: 16px;
    transition: opacity .3s ease;
}

.gallery-box[aria-disabled="true"] {
    opacity: .55;
    pointer-events: none;
    filter: grayscale(.4);
}

.gallery-box__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px dashed #e8d9c8;
    flex-wrap: wrap;
}

.gallery-box__head strong {
    font-size: 14px;
    color: #800020;
    font-weight: 800;
}

.btn--xs {
    padding: 7px 14px !important;
    font-size: 12.5px !important;
    border-radius: 8px !important;
}

.gallery-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.gallery-empty {
    text-align: center;
    color: #b3a29a;
    font-size: 13px;
    padding: 20px;
    background: #fff;
    border: 1px dashed #e8d9c8;
    border-radius: 10px;
    margin: 0;
}

.gallery-item {
    display: grid;
    grid-template-columns: 24px 1fr 40px;
    gap: 10px;
    align-items: center;
    background: #fff;
    border: 1px solid #e8d9c8;
    border-radius: 10px;
    padding: 8px 12px;
    animation: adminFadeIn .25s ease;
}

.gallery-item__num {
    font-size: 12px;
    font-weight: 800;
    color: #800020;
    text-align: center;
    background: #F3E6D5;
    border-radius: 6px;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
}

.gallery-item input {
    border: none;
    outline: none;
    background: transparent;
    font-family: inherit;
    font-size: 13px;
    color: #2b1518;
    padding: 6px 0;
    direction: ltr;
    min-width: 0;
    width: 100%;
}

.gallery-item input::placeholder {
    color: #b3a29a;
}

.gallery-item__remove {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: #ffebee;
    color: #b71c1c;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all .3s ease;
    font-size: 14px;
    font-weight: 900;
    flex-shrink: 0;
}

.gallery-item__remove:hover {
    background: #b71c1c;
    color: #fff;
    transform: rotate(90deg);
}

/* ============================================================
   27. MODAL FOOTER (better spacing)
============================================================ */
.admin-modal__foot {
    gap: 10px;
}

.admin-modal__foot .btn {
    min-width: 120px;
    justify-content: center;
}

/* ============================================================
   28. RESPONSIVE — PRODUCT MODAL
============================================================ */
@media (max-width: 900px) {
    .admin-modal__dialog--xwide {
        max-width: 100%;
    }

    .product-tabs {
        padding-inline: 8px;
    }

    .product-tab {
        padding: 12px 14px;
        font-size: 12.5px;
        gap: 6px;
    }

    .product-tab svg {
        display: none;
    }
}

@media (max-width: 600px) {
    .product-tab {
        padding: 10px 12px;
        font-size: 12px;
    }

    .gallery-item {
        grid-template-columns: 24px 1fr 32px;
        gap: 8px;
        padding: 8px 10px;
    }

    .admin-modal__foot {
        flex-direction: column-reverse;
    }

    .admin-modal__foot .btn {
        width: 100%;
    }
}


/* ============================================================
   29. TICKET REPLY SYSTEM
============================================================ */
.admin-ticket__thread {
    background: #fff;
    border: 1px solid #f0e6d8;
    border-radius: 12px;
    padding: 14px;
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 320px;
    overflow-y: auto;
}

.admin-ticket__thread::-webkit-scrollbar {
    width: 6px;
}

.admin-ticket__thread::-webkit-scrollbar-thumb {
    background: #e8d9c8;
    border-radius: 999px;
}

.ticket-msg {
    display: flex;
    gap: 10px;
    max-width: 88%;
    animation: adminFadeIn .25s ease;
}

.ticket-msg--user {
    align-self: flex-start;
}

.ticket-msg--admin {
    align-self: flex-end;
    flex-direction: row-reverse;
}

.ticket-msg__avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 13px;
    color: #fff;
}

.ticket-msg--user .ticket-msg__avatar {
    background: linear-gradient(135deg, #1565c0, #42a5f5);
}

.ticket-msg--admin .ticket-msg__avatar {
    background: linear-gradient(135deg, #800020, #D45060);
}

.ticket-msg__body {
    background: #FFF9F2;
    border: 1px solid #f0e6d8;
    border-radius: 14px;
    padding: 10px 14px;
    font-size: 13.5px;
    line-height: 1.9;
    color: #2b1518;
    position: relative;
}

.ticket-msg--admin .ticket-msg__body {
    background: #F3E6D5;
    border-color: #e8d9c8;
}

.ticket-msg__body p {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
}

.ticket-msg__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 11px;
    color: #6b5a5a;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px dashed #e8d9c8;
    flex-wrap: wrap;
}

.ticket-msg__meta strong {
    font-weight: 800;
    color: #800020;
}

.ticket-msg--user .ticket-msg__meta strong {
    color: #1565c0;
}

/* ---- Reply Form ---- */
.admin-ticket__reply {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    background: #FFF9F2;
    border: 1px solid #e8d9c8;
    border-radius: 12px;
    margin-top: 12px;
}

.admin-ticket__reply textarea {
    width: 100%;
    min-height: 90px;
    padding: 12px 14px;
    border: 1.5px solid #e8d9c8;
    border-radius: 10px;
    background: #fff;
    font-family: inherit;
    font-size: 13.5px;
    line-height: 1.8;
    color: #2b1518;
    resize: vertical;
    outline: none;
    transition: all .3s ease;
}

.admin-ticket__reply textarea:focus {
    border-color: #800020;
    box-shadow: 0 0 0 4px rgba(128, 0, 32, .08);
}

.admin-ticket__reply-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    flex-wrap: wrap;
}

.admin-ticket__reply-actions .btn {
    padding: 9px 18px;
    font-size: 13px;
}

/* ---- Status badges ---- */
.admin-ticket__status {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    background: #e3f2fd;
    color: #1565c0;
}

/* ============================================================
   30. USER DETAIL — Enhanced
============================================================ */
.admin-user-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 20px;
}

.admin-user-stat {
    background: #FFF9F2;
    border: 1px solid #f0e6d8;
    border-radius: 12px;
    padding: 12px;
    text-align: center;
}

.admin-user-stat strong {
    display: block;
    font-size: 20px;
    font-weight: 900;
    color: #800020;
    line-height: 1.2;
    margin-bottom: 2px;
}

.admin-user-stat span {
    font-size: 11.5px;
    color: #6b5a5a;
    line-height: 1.4;
}

.admin-user-stat--wine {
    background: linear-gradient(135deg, #800020, #5e0018);
    border-color: transparent;
}

.admin-user-stat--wine strong,
.admin-user-stat--wine span {
    color: #FFF9F2;
}

/* Login history */
.admin-login-history {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 240px;
    overflow-y: auto;
    padding: 4px;
}

.admin-login-history::-webkit-scrollbar {
    width: 6px;
}

.admin-login-history::-webkit-scrollbar-thumb {
    background: #e8d9c8;
    border-radius: 999px;
}

.admin-login-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: #FFF9F2;
    border: 1px solid #f0e6d8;
    border-radius: 10px;
    font-size: 12.5px;
    transition: all .2s ease;
}

.admin-login-item:hover {
    border-color: #800020;
}

.admin-login-item__icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    font-size: 14px;
}

.admin-login-item--in .admin-login-item__icon {
    background: #e8f5e9;
    color: #2e7d32;
}

.admin-login-item--out .admin-login-item__icon {
    background: #ffebee;
    color: #b71c1c;
}

.admin-login-item__info {
    flex: 1;
    min-width: 0;
}

.admin-login-item__info strong {
    display: block;
    font-size: 12.5px;
    color: #800020;
    font-weight: 800;
    margin-bottom: 1px;
}

.admin-login-item__info small {
    display: block;
    font-size: 11px;
    color: #6b5a5a;
    direction: ltr;
    text-align: right;
    unicode-bidi: plaintext;
}

.admin-login-item__time {
    font-size: 11px;
    color: #6b5a5a;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
}

/* Reviews */
.admin-user-review {
    background: #FFF9F2;
    border: 1px solid #f0e6d8;
    border-radius: 12px;
    padding: 12px 14px;
}

.admin-user-review__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
    flex-wrap: wrap;
}

.admin-user-review__head strong {
    font-size: 13px;
    color: #800020;
    font-weight: 800;
}

.admin-user-review__stars {
    color: #e0a800;
    font-size: 14px;
    letter-spacing: -1px;
}

.admin-user-review p {
    font-size: 12.5px;
    color: #6b5a5a;
    line-height: 1.8;
    margin: 0 0 6px;
    white-space: pre-wrap;
}

.admin-user-review small {
    font-size: 11px;
    color: #b3a29a;
}

/* Responsive */
@media (max-width: 600px) {
    .admin-user-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .admin-ticket__thread {
        max-height: 260px;
    }

    .ticket-msg {
        max-width: 100%;
    }

    .admin-ticket__reply-actions {
        flex-direction: column-reverse;
    }

    .admin-ticket__reply-actions .btn {
        width: 100%;
    }
}


/* ============================= notification items =============================== */
/* ============================================================
   31. ADMIN TICKET CARD (New Design)
============================================================ */
.admin-tickets {
    display: flex;
    flex-direction: column;
    gap: 22px;
}

.admin-ticket-card {
    background: #fff;
    border: 1px solid #e8d9c8;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(128, 0, 32, .06);
    transition: box-shadow .3s ease;
}

.admin-ticket-card:hover {
    box-shadow: 0 8px 24px rgba(128, 0, 32, .1);
}

/* ---- Head ---- */
.admin-ticket-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    background: linear-gradient(135deg, #FFF9F2 0%, #F3E6D5 100%);
    border-bottom: 1px solid #e8d9c8;
    flex-wrap: wrap;
}

.admin-ticket-card__title h3 {
    font-size: 16px;
    font-weight: 900;
    color: #800020;
    margin: 0 0 6px;
    line-height: 1.4;
}

.admin-ticket-card__sub {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 12.5px;
    color: #6b5a5a;
}

.admin-ticket-card__sub strong {
    color: #800020;
    font-weight: 800;
}

.admin-ticket-card__sub span:nth-child(even) {
    opacity: .4;
}

.admin-ticket-card__badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    flex-shrink: 0;
}

/* ---- Info bar ---- */
.admin-ticket-card__info {
    display: flex;
    gap: 24px;
    padding: 12px 22px;
    background: #FFF9F2;
    border-bottom: 1px solid #f0e6d8;
    font-size: 12.5px;
    color: #6b5a5a;
    flex-wrap: wrap;
}

.admin-ticket-card__info strong {
    color: #800020;
    font-weight: 800;
    margin-inline-end: 4px;
}

/* ============================================================
   32. TICKET CHAT THREAD
============================================================ */
.admin-ticket-thread {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: #fafaf8;
    max-height: 500px;
    overflow-y: auto;
    scrollbar-width: thin;
}

.admin-ticket-thread::-webkit-scrollbar {
    width: 6px;
}

.admin-ticket-thread::-webkit-scrollbar-track {
    background: transparent;
}

.admin-ticket-thread::-webkit-scrollbar-thumb {
    background: #e8d9c8;
    border-radius: 999px;
}

/* ---- Message row ---- */
.ticket-msg {
    display: flex;
    gap: 10px;
    align-items: flex-end;
    max-width: 80%;
    animation: adminFadeIn .3s ease;
}

.ticket-msg--user {
    align-self: flex-start;
    flex-direction: row;
}

.ticket-msg--admin {
    align-self: flex-end;
    flex-direction: row-reverse;
}

/* ---- Avatar ---- */
.ticket-msg__avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 14px;
    color: #fff;
    box-shadow: 0 3px 8px rgba(0, 0, 0, .12);
    align-self: flex-end;
}

.ticket-msg--user .ticket-msg__avatar {
    background: linear-gradient(135deg, #1565c0, #42a5f5);
}

.ticket-msg--admin .ticket-msg__avatar {
    background: linear-gradient(135deg, #800020, #D45060);
}

/* ---- Content ---- */
.ticket-msg__content {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
}

.ticket-msg--user .ticket-msg__content {
    align-items: flex-start;
}

.ticket-msg--admin .ticket-msg__content {
    align-items: flex-end;
}

/* ---- Bubble ---- */
.ticket-msg__bubble {
    background: #fff;
    border: 1px solid #e8d9c8;
    border-radius: 16px;
    padding: 12px 16px;
    font-size: 13.5px;
    line-height: 1.9;
    color: #2b1518;
    word-wrap: break-word;
    box-shadow: 0 2px 6px rgba(0, 0, 0, .04);
    position: relative;
}

.ticket-msg__bubble p {
    margin: 0;
    white-space: pre-wrap;
}

.ticket-msg--user .ticket-msg__bubble {
    border-top-left-radius: 4px;
    border-color: #cfe1f3;
    background: #f0f7ff;
}

.ticket-msg--admin .ticket-msg__bubble {
    border-top-right-radius: 4px;
    background: linear-gradient(135deg, #F3E6D5, #fff5e8);
    border-color: #e8d9c8;
}

/* ---- Meta ---- */
.ticket-msg__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: #6b5a5a;
    padding: 0 4px;
}

.ticket-msg__meta strong {
    font-weight: 800;
}

.ticket-msg--user .ticket-msg__meta strong {
    color: #1565c0;
}

.ticket-msg--admin .ticket-msg__meta strong {
    color: #800020;
}

.ticket-msg__meta span {
    opacity: .7;
    font-variant-numeric: tabular-nums;
}

/* ============================================================
   33. TICKET REPLY FORM (Admin)
============================================================ */
.admin-ticket-reply {
    background: #FFF9F2;
    border-top: 1px solid #e8d9c8;
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.admin-ticket-reply__head {
    font-size: 13.5px;
    color: #800020;
    font-weight: 800;
}

.admin-ticket-reply textarea {
    width: 100%;
    min-height: 90px;
    padding: 12px 16px;
    border: 1.5px solid #e8d9c8;
    border-radius: 12px;
    background: #fff;
    font-family: inherit;
    font-size: 13.5px;
    line-height: 1.9;
    color: #2b1518;
    resize: vertical;
    outline: none;
    transition: all .3s ease;
}

.admin-ticket-reply textarea:focus {
    border-color: #800020;
    box-shadow: 0 0 0 4px rgba(128, 0, 32, .08);
}

.admin-ticket-reply textarea::placeholder {
    color: #b3a29a;
}

.admin-ticket-reply__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.admin-ticket-reply__actions .admin-status-select {
    padding: 8px 14px;
    border-radius: 10px;
    border: 1.5px solid #e8d9c8;
    background: #fff;
    font-size: 12.5px;
    font-weight: 700;
    color: #800020;
    cursor: pointer;
    font-family: inherit;
    min-width: 140px;
}

.admin-ticket-reply__actions .admin-status-select:focus {
    border-color: #800020;
    outline: none;
}

.admin-ticket-reply__actions .admin-action-btn--delete {
    padding: 9px 16px;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 700;
    background: #ffebee;
    color: #b71c1c;
    border: none;
    cursor: pointer;
    transition: all .3s ease;
    font-family: inherit;
}

.admin-ticket-reply__actions .admin-action-btn--delete:hover {
    background: #b71c1c;
    color: #fff;
}

.admin-ticket-reply__send {
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #800020, #5e0018);
    color: #FFF9F2;
    border: none;
    cursor: pointer;
    transition: all .3s ease;
    font-family: inherit;
    box-shadow: 0 4px 12px rgba(128, 0, 32, .25);
}

.admin-ticket-reply__send:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(128, 0, 32, .3);
}

.admin-ticket-reply__send svg {
    flex-shrink: 0;
}

/* ============================================================
   34. RESPONSIVE — TICKETS
============================================================ */
@media (max-width: 768px) {
    .admin-ticket-card__head {
        padding: 16px;
    }

    .admin-ticket-card__title h3 {
        font-size: 14.5px;
    }

    .admin-ticket-thread {
        padding: 16px;
        max-height: 400px;
    }

    .ticket-msg {
        max-width: 92%;
    }

    .ticket-msg__avatar {
        width: 32px;
        height: 32px;
        font-size: 12px;
    }

    .ticket-msg__bubble {
        padding: 10px 14px;
        font-size: 13px;
    }

    .admin-ticket-reply {
        padding: 14px 16px;
    }

    .admin-ticket-reply__actions {
        flex-direction: column-reverse;
        align-items: stretch;
    }

    .admin-ticket-reply__actions .admin-status-select,
    .admin-ticket-reply__actions .admin-action-btn--delete,
    .admin-ticket-reply__actions .admin-ticket-reply__send {
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 480px) {
    .admin-ticket-card__info {
        flex-direction: column;
        gap: 6px;
    }

    .ticket-msg {
        max-width: 100%;
    }
}

/* ==================================== notification comments user ======================================== */
/* ============================================================
   35. ADMIN REVIEWS
============================================================ */
.admin-reviews {
    display: flex;
    flex-direction: column;
    gap: 22px;
}

.admin-review-card {
    background: #fff;
    border: 1px solid #e8d9c8;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(128, 0, 32, .06);
    transition: box-shadow .3s ease;
}

.admin-review-card:hover {
    box-shadow: 0 8px 24px rgba(128, 0, 32, .1);
}

.admin-review-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    background: linear-gradient(135deg, #FFF9F2 0%, #F3E6D5 100%);
    border-bottom: 1px solid #e8d9c8;
    flex-wrap: wrap;
}

.admin-review-card__title h3 {
    font-size: 16px;
    font-weight: 900;
    color: #800020;
    margin: 0 0 6px;
    line-height: 1.4;
}

.admin-review-card__sub {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 12.5px;
    color: #6b5a5a;
}

.admin-review-card__sub strong {
    color: #800020;
    font-weight: 800;
}

.admin-review-card__sub span:nth-child(even) {
    opacity: .4;
}

.admin-review-card__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.admin-review-stars {
    font-size: 18px;
    letter-spacing: 1px;
    color: #e0a800;
    text-shadow: 0 1px 2px rgba(0, 0, 0, .1);
}

.review-stars-inline {
    color: #e0a800;
    font-size: 13px;
    letter-spacing: 1px;
    margin-inline: 4px;
}

.admin-review-thread {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: #fafaf8;
    max-height: 400px;
    overflow-y: auto;
    scrollbar-width: thin;
}

.admin-review-thread::-webkit-scrollbar {
    width: 6px;
}

.admin-review-thread::-webkit-scrollbar-thumb {
    background: #e8d9c8;
    border-radius: 999px;
}

.admin-review-reply {
    background: #FFF9F2;
    border-top: 1px solid #e8d9c8;
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.admin-review-reply__head {
    font-size: 13.5px;
    color: #800020;
    font-weight: 800;
}

.admin-review-reply textarea {
    width: 100%;
    min-height: 80px;
    padding: 12px 16px;
    border: 1.5px solid #e8d9c8;
    border-radius: 12px;
    background: #fff;
    font-family: inherit;
    font-size: 13.5px;
    line-height: 1.9;
    color: #2b1518;
    resize: vertical;
    outline: none;
    transition: all .3s ease;
}

.admin-review-reply textarea:focus {
    border-color: #800020;
    box-shadow: 0 0 0 4px rgba(128, 0, 32, .08);
}

.admin-review-reply textarea::placeholder {
    color: #b3a29a;
}

.admin-review-reply__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.admin-review-reply__actions .admin-action-btn--delete {
    padding: 9px 16px;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 700;
    background: #ffebee;
    color: #b71c1c;
    border: none;
    cursor: pointer;
    transition: all .3s ease;
    font-family: inherit;
}

.admin-review-reply__actions .admin-action-btn--delete:hover {
    background: #b71c1c;
    color: #fff;
}

.admin-review-reply__send {
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #800020, #5e0018);
    color: #FFF9F2;
    border: none;
    cursor: pointer;
    transition: all .3s ease;
    font-family: inherit;
    box-shadow: 0 4px 12px rgba(128, 0, 32, .25);
}

.admin-review-reply__send:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(128, 0, 32, .3);
}

@media (max-width: 768px) {
    .admin-review-card__head {
        padding: 16px;
    }

    .admin-review-card__title h3 {
        font-size: 14.5px;
    }

    .admin-review-thread {
        padding: 16px;
        max-height: 320px;
    }

    .admin-review-reply {
        padding: 14px 16px;
    }

    .admin-review-reply__actions {
        flex-direction: column-reverse;
        align-items: stretch;
    }

    .admin-review-reply__actions button {
        width: 100%;
        justify-content: center;
    }
}

/* ============================================================
   ADMIN ORDERS TABLE (Enhanced)
============================================================ */
.admin-table--orders {
    min-width: 900px;
}

.admin-row-num {
    display: inline-grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 6px;
    background: linear-gradient(135deg, var(--wine, #800020), #5e0018);
    color: #FFF9F2;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
}

.admin-order-code {
    color: #800020;
    font-weight: 800;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    direction: ltr;
    display: inline-block;
}

.admin-customer-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.admin-customer-cell strong {
    font-size: 13.5px;
    color: #800020;
    font-weight: 800;
    margin-bottom: 1px;
}

.admin-customer-cell small {
    font-size: 11px;
    color: #6b5a5a;
    white-space: nowrap;
}

.admin-products-cell {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    max-width: 260px;
}

.admin-products-cell__img {
    position: relative;
    flex-shrink: 0;
}

.admin-products-cell__img img {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    object-fit: cover;
    background: #F3E6D5;
    border: 1px solid #e8d9c8;
}

.admin-products-cell__badge {
    position: absolute;
    bottom: -4px;
    inset-inline-end: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    background: linear-gradient(135deg, #800020, #D45060);
    color: #FFF9F2;
    font-size: 10px;
    font-weight: 900;
    border-radius: 999px;
    display: grid;
    place-items: center;
    border: 2px solid #fff;
    box-shadow: 0 2px 6px rgba(128, 0, 32, .25);
}

.admin-products-cell__info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
}

.admin-products-cell__info small {
    font-size: 12px;
    color: #2b1518;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-height: 1.5;
}

.admin-products-cell__count {
    font-size: 10.5px;
    color: #6b5a5a;
    background: #F3E6D5;
    border-radius: 6px;
    padding: 2px 8px;
    width: fit-content;
    font-weight: 700;
}

.admin-date-cell strong {
    font-size: 12.5px;
    color: #2b1518;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
}

.admin-amount-cell {
    color: #800020;
    font-weight: 900;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
}

.admin-action-btn--edit {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

@media (max-width: 768px) {
    .admin-products-cell {
        max-width: 180px;
    }

    .admin-products-cell__info small {
        font-size: 11.5px;
    }
}



